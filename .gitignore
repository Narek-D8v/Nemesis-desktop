# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Виртуальное окружение
venv/
.venv/
env/

# Секреты и локальный конфиг
config/config.yaml
.env
.env.*
!.env.telegram.example

# Логи и временные файлы
*.log
*.tmp
*.bak
*.orig
*.rej

# Данные (память, логи, модели)
data/
!data/.gitkeep

# Кэш
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Сборка
build/
dist/
*.spec
!Nemesis.spec

# Скиллы агентов — сторона, ставится локально (npx skills add),
