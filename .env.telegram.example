# Скопируй в .env.telegram и заполни. Файл НЕ коммить: в нём токен и ключи.
# Docker Compose подхватывает его целиком.

# --- Telegram ---
NEMUS_TELEGRAM__ENABLED=true
NEMUS_TELEGRAM__TOKEN=123456789:AA...токен_от_BotFather
# ID пользователей через запятую (узнать свой: написать боту /id после запуска
# с пустым списком не выйдет — впиши ID, который показывает @userinfobot).
NEMUS_TELEGRAM__ALLOWED_USERS=123456789

# --- Модель ---
NEMUS_LLM__DEFAULT_PROVIDER=gemini
NEMUS_LLM__DEFAULT_MODEL=gemini/gemini-3.5-flash-lite
NEMUS_LLM__REASONING_EFFORT=low
NEMUS_LLM__MAX_TOKENS=4096

# Ключ Gemini (https://aistudio.google.com/apikey)
NEMUS_LLM__PROVIDERS__GEMINI__API_KEY=

# Запасной бесплатный вариант (можно оставить пустым)
# NEMUS_LLM__PROVIDERS__OPENROUTER__API_KEY=
# NEMUS_LLM__FALLBACK=[{"provider":"openrouter","model":"openrouter/google/gemma-4-31b-it:free"}]

# --- Логи и лимиты ---
NEMUS_LOGGING__LEVEL=INFO
NEMUS_TOOLS__MAX_RUN_TOKENS=500000

# Рабочая папка и БД лежат в /app/data (том ./data), пути менять не нужно.
